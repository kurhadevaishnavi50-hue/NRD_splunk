    "dataSources": {
        "ds_9ps1HY8v": {
            "name": "Total Attacks - Total Attacks search",
            "options": {
                "query": "index=network_recon\n| stats count",
                "queryParameters": {
                    "earliest": "-24h@h",
                    "latest": "now"
                }
            },
            "type": "ds.search"
        },
        "ds_Nwu5bc1f": {
            "name": "Top Attacker IP - Top Attacker IP search",
            "options": {
                "query": "index=network_recon\n| top \"source_ip\"",
                "queryParameters": {
                    "earliest": "-24h@h",
                    "latest": "now"
                }
            },
            "type": "ds.search"
        },
        "ds_O3StUaKP": {
            "name": "Severity Distribution - Severity Distribution search",
            "options": {
                "query": "index=network_recon\n| stats count by severity",
                "queryParameters": {
                    "earliest": "-24h@h",
                    "latest": "now"
                }
            },
            "type": "ds.search"
        },
        "ds_YniZFlkk": {
            "name": "Attack Heat Map - Attack Heat Map search",
            "options": {
                "query": "index=network_recon\n| chart count over \"source_ip\" by \"scan_type\"",
                "queryParameters": {
                    "earliest": "-24h@h",
                    "latest": "now"
                }
            },
            "type": "ds.search"
        },
        "ds_elabHaYx": {
            "name": "Critical Alerts - Critical Alerts 1 search",
            "options": {
                "query": "index=network_recon severity=CRITICAL",
                "queryParameters": {
                    "earliest": "-24h@h",
                    "latest": "now"
                }
            },
            "type": "ds.search"
        },
        "ds_h5GxKm4e": {
            "name": "Most Targeted Ports - Events 1 search",
            "options": {
                "query": "index=network_recon\n| top Port",
                "queryParameters": {
                    "earliest": "-24h@h",
                    "latest": "now"
                }
            },
            "type": "ds.search"
        },
        "ds_jT7FkgqT": {
            "name": "Most Targeted Ports - Events 2 search",
            "options": {
                "extend": "ds_h5GxKm4e",
                "query": "| fieldsummary maxvals=10"
            },
            "type": "ds.chain"
        },
        "ds_jbhYI9BT": {
            "name": "Critical Alerts - Critical Alerts 2 search",
            "options": {
                "extend": "ds_elabHaYx",
                "query": "| fieldsummary maxvals=10"
            },
            "type": "ds.chain"
        },
        "ds_rHsPeX14": {
            "name": "Scan Type - Scan Type search",
            "options": {
                "query": "index=network_recon\n| stats count by \"scan_type\"",
                "queryParameters": {
                    "earliest": "-24h@h",
                    "latest": "now"
                }
            },
            "type": "ds.search"
        },
        "ds_va4EetXO": {
            "name": "Timeline - Timeline search",
            "options": {
                "query": "index=network_recon\n| timechart count by \"Scan Type\"",
                "queryParameters": {
                    "earliest": "-24h@h",
                    "latest": "now"
                }
            },
            "type": "ds.search"
        }
    },
